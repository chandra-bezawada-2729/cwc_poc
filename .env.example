# Root-level environment variables
# Copy this file to .env and fill in real values. Never commit .env.

# --- Native PostgreSQL (primary setup path) ---
# DB_URL and DB_PASSWORD override the defaults in application.properties.
# Default values target the local cwc database created in Step 2 of the README.
DB_URL=jdbc:postgresql://localhost:5432/cwc
DB_PASSWORD=cwc_dev_password

# --- Docker Compose (optional fallback) ---
# Only needed if using docker-compose.yml instead of native PostgreSQL.
POSTGRES_PASSWORD=

# --- Shared across services ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5

# Optional: override AI service URL seen by the backend
AI_SERVICE_URL=http://127.0.0.1:5002

# --- Full Docker stack (docker-compose.yml, see DOCKER.md) ---
CWC_DB_PASSWORD=<generate: long random string>
LLM_API_KEY=<same key as local-llm/.env>
# Optional: CWC_DATA_DIR=C:/CWC_DOCKER  WEB_PORT=8088  CWC_ROUTING_MODE=AUTO
