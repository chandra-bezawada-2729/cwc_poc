# CWC AI Service — environment variables
# Copy to .env and fill in real values. Never commit .env.

SERVER_PORT=5002

# Tesseract binary path. Required if tesseract is not on system PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
FLASK_DEBUG=false

# LLM provider — anthropic | openai
LLM_PROVIDER=anthropic

# Anthropic (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-5
# Optional: cheaper model for the extraction pass (defaults to ANTHROPIC_MODEL)
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-5
CWC_PROMPT_CACHE=1
CWC_THINKING=disabled

# OpenAI (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# PostgreSQL (used by the AI service for direct DB writes if needed)
DB_URL=postgresql://cwc:cwc_dev_password@localhost:5432/cwc

# PHI safety — set true only for local debugging, never in production
CWC_DEBUG_LOG_OCR_TEXT=false

# Path to the real fax PDFs on this machine (PHI — never inside the repo).
# Used by evaluation/run_eval.py and by FolderWatcherService in Phase 8.
# Point at the Desktop folder where the originals live.
CWC_DATASET_PATH=C:\Users\ABC\OneDrive - AvenirDigital Solutions Pvt. Ltd (1)\Desktop\cwc healthcare datasets

# ── Self-hosted Qwen instead of Anthropic (see local-llm/docker-compose.yml) ──
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8081/v1
# OPENAI_API_KEY=<key printed by local-llm/new-api-key.ps1>
# OPENAI_MODEL=qwen3.5-9b
# CWC_MAX_RENDER_PAGES=3          # fewer page images = faster on a laptop GPU
# CWC_LLM_TIMEOUT_SECS=600
