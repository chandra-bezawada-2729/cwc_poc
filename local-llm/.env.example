# ─────────────────────────────────────────────────────────────────────────────
# local-llm/.env  —  copy this file to .env and set the values.
# This is the ONLY file that differs between the laptop and the client server.
# ─────────────────────────────────────────────────────────────────────────────

# Generated once by new-api-key.ps1. Must match LLM_API_KEY in the ROOT .env.
LLM_API_KEY=

# The name the application asks for, i.e. the "model" field in every request.
# Keep this in step with the ROOT .env LLM_ALIAS - they must match.
SGLANG_ALIAS=cwc-llm

# ── LAPTOP PROFILE (RTX 4060, 8 GB) ──────────────────────────────────────────
SGLANG_MODEL=Qwen/Qwen3.5-4B
SGLANG_CONTEXT=16384
SGLANG_MEM=0.80
SGLANG_MAX_RUNNING=1
# fp8 halves the weights (Ada/Hopper+ only). CUDA graphs are disabled because
# capture needs spare VRAM this card does not have.
SGLANG_EXTRA_ARGS=--quantization fp8 --disable-cuda-graph

# ── CLIENT / AWS PROFILE (24 GB+ GPU) ────────────────────────────────────────
# Comment out the laptop block above and use these instead. Nothing else changes.
# SGLANG_MODEL=Qwen/Qwen3.5-9B
# SGLANG_ALIAS=cwc-llm  (unchanged - that is the point)
# SGLANG_CONTEXT=32768
# SGLANG_MEM=0.87
# SGLANG_MAX_RUNNING=4
# SGLANG_EXTRA_ARGS=

# ── Rarely changed ───────────────────────────────────────────────────────────
# Pin this to the exact tag once a version is validated. Never ship "latest".
SGLANG_TAG=latest
SGLANG_PORT=30000
SGLANG_SHM=8g
