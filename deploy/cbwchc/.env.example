# ─────────────────────────────────────────────────────────────────────────────
# deploy/cbwchc/.env  —  copy to .env, then: chmod 600 .env
# This is the ONLY file that differs between environments.
# ─────────────────────────────────────────────────────────────────────────────

# Engine key. Created during the session; known only to the gateway.
#   echo "API_KEY=$(openssl rand -hex 32)" > .env
API_KEY=

HF_HOME=/opt/models/hf
DATA_DIR=/srv/cwc-data

# ── Model ────────────────────────────────────────────────────────────────────
# Pinned by digest, never by tag. download-models.sh prints the digest.
SGLANG_IMAGE=lmsysorg/sglang:dev-qwen38-27b-dflash2
MODEL_PATH=RadixArk/Qwen3.8-27B-NVFP4-BF16-LMHead
DRAFT_MODEL_PATH=z-lab/Qwen3.8-27B-DFlash2
SERVED_NAME=qwen3.8-27b

# ── Engine tuning (values from the vendor guide, verified for this hardware) ──
# MEM_FRACTION must stay at 0.50. Higher values have frozen GB10 machines,
# requiring a power cycle. Raise only after your own soak test.
MEM_FRACTION=0.50
CONTEXT_LENGTH=262144
MAX_RUNNING=8
DRAFT_TOKENS=8
MAX_MAMBA_CACHE=96

# Absolute path to the gateway certificate. Must be absolute: Docker Compose
# resolves relative paths against the repo root when the application stack runs.
TLS_CERT=/opt/cwc/deploy/cbwchc/tls/llm.crt

# Docker network the gateway sits on. Leave as-is for a normal deployment.
LLM_NETWORK=cwc-llm_edge

# ── Web interface ────────────────────────────────────────────────────────────
WEB_PORT=8088
WEB_HTPASSWD=/opt/cwc/web/.htpasswd

# ── Placeholders for the unused llama.cpp service ────────────────────────────
# The repository's root compose file defines an llm service for the laptop
# setup. compose.app.yml disables it with a profile, but Docker Compose still
# resolves variables for every service, profile or not — so these must exist.
# They are never used.
LLM_API_KEY=unused
LLM_ALIAS=unused

# ── Database ─────────────────────────────────────────────────────────────────
CWC_DB_PASSWORD=
