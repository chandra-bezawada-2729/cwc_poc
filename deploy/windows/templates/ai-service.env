# CWC AI service - production settings. Copy to D:\cwc\app\cwc-ai-service\.env
# and restrict the file to Administrators + the service account.
SERVER_HOST=127.0.0.1
SERVER_PORT=5002
CWC_SERVER=waitress
FLASK_DEBUG=false

# Local Qwen model server (cwc-llm service)
LLM_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:8081/v1
OPENAI_API_KEY=CHANGE_ME_contents_of_D:\cwc\llm\api-key.txt
OPENAI_MODEL=qwen3.8-27b
CWC_LLM_TIMEOUT_SECS=600
CWC_MAX_RENDER_PAGES=3

# No cloud AI in production
ANTHROPIC_API_KEY=

TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
CWC_DEBUG_LOG_OCR_TEXT=false
