# Copy to .env, then: chmod 600 .env
# Step 1 of the guide creates this on the box instead:
#   echo "API_KEY=$(openssl rand -hex 32)" > .env
API_KEY=
HF_HOME=/opt/models/hf

# The model served. Keep the served name stable across environments so the
# application never has to change: it always asks for "qwen-base".
MODEL_PATH=Qwen/Qwen3.5-2B
SERVED_NAME=qwen-base

# SGLang CPU image. Pin to a digest once validated - never ship a floating tag.
SGLANG_IMAGE=lmsysorg/sglang:v0.5.13-xeon

CONTEXT_LENGTH=16384
MAX_RUNNING=4
