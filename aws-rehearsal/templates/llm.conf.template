# Required: per-user API keys are 64 hex chars, longer than nginx's default
# 64-byte map hash bucket. Without these nginx refuses to start with
# "could not build map_hash". NOT present in the source DGX Spark guide.
map_hash_bucket_size 128;
map_hash_max_size 2048;

# Mirrors templates/llm.conf.template from the DGX Spark guide.
# OpenAI clients send "Authorization: Bearer <key>"; Anthropic clients send
# "x-api-key: <key>". Accept both, map to one per-user identity.
map $http_authorization $bearer_key { default ""; "~^Bearer\s+(?<k>\S+)$" $k; }
map $bearer_key $client_key { "" $http_x_api_key; default $bearer_key; }

# One line per person or application.
# Make each key with: openssl rand -hex 32
map $client_key $llm_user {
    default "";
    "PASTE_KEY_FOR_CWC_AI_SERVICE" "cwc-ai-service";
    "PASTE_KEY_FOR_TESTER_1"       "tester-1";
}

log_format llm_audit escape=json
  '{"time":"$time_iso8601","user":"$llm_user","ip":"$remote_addr",'
  '"method":"$request_method","path":"$uri","status":"$status",'
  '"in_bytes":$request_length,"out_bytes":$bytes_sent,"secs":$request_time}';

server {
    listen 443 ssl;
    http2 on;
    server_name llm.internal;
    ssl_certificate     /etc/nginx/tls/llm.crt;
    ssl_certificate_key /etc/nginx/tls/llm.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Who, when, what - never prompt text.
    access_log /var/log/nginx/llm-audit.log llm_audit;
    client_max_body_size 64m;          # base64 fax page images travel in the body

    location ~ ^/v1/ {
        if ($llm_user = "") { return 401; }
        proxy_set_header Authorization "Bearer ${API_KEY}";   # engine key never leaves the box
        proxy_set_header X-Api-Key "";
        proxy_pass http://qwen:30000;
        proxy_http_version 1.1;
        proxy_buffering off;           # stream tokens as they arrive
        proxy_read_timeout 3600s;      # CPU inference is slow; do not cut it off
    }
    location / { return 404; }         # /metrics and everything else stays internal
}
